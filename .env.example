# Live Drive gallery works with the public shared folder without credentials.
# Optional: use the official Google Drive API for larger albums and a stable listing API.
# Enable Google Drive API in a Google Cloud project, then set this SERVER-ONLY key.
# Do not prefix it with VITE_; do not commit your real .env file.
GOOGLE_DRIVE_API_KEY=

# Guest uploads: deploy google-apps-script/GuestUploads.gs as documented in GUEST_UPLOADS.md.
# Server-only values. Use the same secret in Apps Script's UPLOAD_SECRET property.
DRIVE_UPLOAD_SCRIPT_URL=
DRIVE_UPLOAD_SECRET=

# Optional deployment URL:
# VITE_APP_URL=https://your-wedding-site.example

# Server-only folder configuration: full Drive folder URLs or raw folder IDs.
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_DRIVE_MISC_FOLDER_URL=
