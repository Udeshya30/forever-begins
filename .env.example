# Forever Begins Environment Configuration
# Copy this file to .env and update values if needed
# Note: This application is fully static and does not require environment variables

# Optional: Add your deployed URL after Vercel deployment
# VITE_APP_URL=https://forever-begins.vercel.app

# Optional: Google Analytics tracking ID (if you want to track visitors)
# VITE_GA_ID=GA_MEASUREMENT_ID

# Optional: Custom domain (after you configure it in Vercel)
# VITE_DOMAIN=foreverbegins.com
